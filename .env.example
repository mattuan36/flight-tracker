# Copy to .env and fill in. .env is git-ignored.

# dev | test | prod  (alias: production)
APP_ENV=dev
APP_NAME=Flight Tracker

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required when APP_ENV=prod.
SECRET_KEY=

# Public base URL. Invite links are built from this, never from the request host.
BASE_URL=http://localhost:5000

# Leave blank for local SQLite at instance/dev.sqlite3.
# Production (PythonAnywhere): mysql://USER:PASSWORD@USER.mysql.pythonanywhere-services.com/USER$flighttracker
DATABASE_URL=

# Shown in "ask <admin> for a new invite" messages.
ADMIN_EMAIL=

# mock | serpapi. Set serpapi for live checks; mock keeps local demos free.
PRICE_PROVIDER=mock
LOG_LEVEL=INFO

# SerpAPI Google Flights. The web app never calls it; the scheduled checker and
# `flask probe-prices` do. The plan has no paid overage, so the monthly cap is
# hard-capped at 250 in code even if this is raised. Airline scope is per tracker.
SERPAPI_KEY=
SERPAPI_GL=us
SERPAPI_HL=en
SERPAPI_MONTHLY_CAP=250
SERPAPI_TIMEOUT_SECONDS=20

# The hourly task only checks flights whose interval is due.
CHECK_TASK_MINUTE=0
CHECK_MAX_CALLS_PER_RUN=20

# --- Email: not used until M6, when price alerts start sending. ---
# MAIL_BACKEND=console
# MAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
