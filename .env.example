# Copy to .env and fill in. .env is git-ignored.

# dev | test | prod  (alias: production)
APP_ENV=dev
APP_NAME=Flight Tracker

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Required when APP_ENV=prod.
SECRET_KEY=

# Public base URL. Invite links are built from this, never from the request host.
BASE_URL=http://localhost:5000

# Leave blank for local SQLite at instance/dev.sqlite3.
# Production (PythonAnywhere): mysql://USER:PASSWORD@USER.mysql.pythonanywhere-services.com/USER$flighttracker
DATABASE_URL=

# Shown in "ask <admin> for a new invite" messages.
ADMIN_EMAIL=

# mock | <vendor>  (a real vendor is wired in after the M4b spike)
PRICE_PROVIDER=mock
LOG_LEVEL=INFO

# --- Email: not used until M6, when price alerts start sending. ---
# MAIL_BACKEND=console
# MAIL_FROM=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
